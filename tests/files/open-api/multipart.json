{
    "openapi": "3.1.0",
    "info": {
        "title": "Elysia Documentation",
        "description": "Development documentation",
        "version": "0.1.1"
    },
    "paths": {
        "/upload": {
            "post": {
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "text": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}